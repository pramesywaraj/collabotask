# Application Environment
# development, staging, production
APP_ENV=development
APP_NAME=collabotask
APP_VERSION=0.0.1
APP_DEBUG=true

# Server Configuration
SERVER_PORT=
SERVER_HOST=
SERVER_TIMEOUT= # In second

# Database Configuration
DB_HOST=localhost
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Default disable
DB_SSLMODE=disable
DB_MAX_CONNS=
DB_MIN_CONNS=

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=console

# CORS, use (,) separation for multiple values
# Production: CORS_ALLOWED_ORIGINS=https://app.collabotask.com
# Dev:        CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,X-CSRF-Protection
CORS_ALLOW_CREDENTIALS=true

# Auth
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRATION=
AUTH_BCRYPT_COST=

# Cookie — set COOKIE_SECURE=false and COOKIE_NAME=token for local http dev/CI
COOKIE_SECURE=true
COOKIE_NAME=__Host-token